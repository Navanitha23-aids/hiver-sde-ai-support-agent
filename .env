# Copy this file to .env and fill in values as needed.
# The app works with NO values set at all (fully deterministic fallback mode).

# --- LLM (optional) ----------------------------------------------------
# Set LLM_PROVIDER=anthropic and provide ANTHROPIC_API_KEY to enable
# LLM-generated replies and the LLM-as-judge evaluation script.
# Leave as "none" (or leave ANTHROPIC_API_KEY blank) to use the
# deterministic, template-based fallback — no key required.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Data ----------------------------------------------------------------
# Leave unset to use backend/data by default.
# DATA_DIR=./data

# --- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=3

# --- Escalation thresholds -------------------------------------------------
INTENT_CONFIDENCE_ESCALATION_THRESHOLD=0.45
RETRIEVAL_SIMILARITY_ESCALATION_THRESHOLD=0.15
ALWAYS_ESCALATE_INTENTS=billing_and_payment

# --- Flask -----------------------------------------------------------------
FLASK_PORT=5001
FLASK_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
